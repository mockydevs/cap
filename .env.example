# Public base URL used by browser clients.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AWS S3 (private bucket). The browser never receives these credentials.
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=cap-recordings-development
AWS_KMS_KEY_ARN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional for S3-compatible local development only (e.g. http://localhost:9000).
AWS_S3_ENDPOINT=

# Added when private CloudFront playback is enabled.
AWS_CLOUDFRONT_DOMAIN=
AWS_CLOUDFRONT_DISTRIBUTION_ID=

# Planned services; required from Milestone 2 onward.
DATABASE_URL=postgresql://cap:cap@localhost:5432/cap
REDIS_URL=redis://localhost:6379

# Development-only temporary identity until the authentication milestone.
DEV_UPLOAD_USER_ID=
DEV_UPLOAD_WORKSPACE_ID=
