# Public base URL used by browser clients.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth web client. Register this exact callback URI:
# ${NEXT_PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Public OAuth client of application type "Desktop app".
GOOGLE_DESKTOP_OAUTH_CLIENT_ID=

# Object storage: any S3-compatible store (private bucket). The browser never
# receives these credentials. See docs/decisions/0002-provider-neutral-object-storage.md.
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=cap-recordings-development
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS only: encrypt every object under this key and verify it on read. Leave
# blank on stores without KMS (Cloudflare R2, MinIO, Backblaze B2).
AWS_KMS_KEY_ARN=
# Set for any non-AWS store, which also selects path-style addressing.
#   Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com (AWS_REGION=auto)
#   MinIO locally: http://localhost:9000
AWS_S3_ENDPOINT=

# Added when private CloudFront playback is enabled.
AWS_CLOUDFRONT_DOMAIN=
AWS_CLOUDFRONT_DISTRIBUTION_ID=

# Application database and processing queue.
DATABASE_URL=postgresql://cap:cap@localhost:5432/cap
REDIS_URL=redis://localhost:6379

# Transcription worker (OpenAI-compatible /audio/transcriptions API).
TRANSCRIPTION_PROVIDER=openai-compatible
TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
TRANSCRIPTION_WORKER_CONCURRENCY=2
TRANSCRIPTION_CONSENT_BASIS=WORKSPACE_POLICY
# At least 32 random characters; used only for HMAC pseudonyms and view grants.
ANALYTICS_HASH_SECRET=
AI_BASE_URL=https://api.openai.com/v1
AI_PROVIDER=OPENAI
AI_API_KEY=
AI_ALLOW_DEPLOYMENT_CREDENTIAL=false
# Seals workspace AI provider keys. Set exactly one; KMS wins if both are set.
# Web and AI worker must agree. Local key: openssl rand -base64 32
AI_CREDENTIALS_KMS_KEY_ARN=
AI_CREDENTIALS_LOCAL_KEY=
AI_MODEL=gpt-5-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_INPUT_COST_MICROUNITS_PER_MILLION=250000
AI_OUTPUT_COST_MICROUNITS_PER_MILLION=2000000
AI_WORKER_CONCURRENCY=2
MEDIA_WORKER_CONCURRENCY=1
MEDIA_WORKER_HEALTH_PORT=8081
# Seals webhook signing secrets, separately from AI credentials. Set exactly
# one; web and webhook worker must agree. Local key: openssl rand -base64 32
WEBHOOK_SECRETS_KMS_KEY_ARN=
WEBHOOK_SECRETS_LOCAL_KEY=
WEBHOOK_WORKER_CONCURRENCY=4
WEBHOOK_WORKER_HEALTH_PORT=8085
