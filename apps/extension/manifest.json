{
  "manifest_version": 3,
  "name": "Cap Meeting Recorder",
  "version": "0.1.0",
  "description": "Record a meeting tab (audio or video) with a visible indicator and send the transcript to the Calari portal.",
  "minimum_chrome_version": "116",
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Cap",
    "default_icon": {
      "128": "src/icon.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "src/options.html",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "identity"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://calendar.google.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "oauth2": {
    "client_id": "SET_CHROME_EXTENSION_OAUTH_CLIENT_ID.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/calendar.events.readonly"]
  },
  "commands": {
    "toggle-recording": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Start or stop recording the current tab"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://calendar.google.com/*"],
      "js": ["src/calendar.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["src/meet.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [],
  "icons": {
    "128": "src/icon.png"
  }
}
