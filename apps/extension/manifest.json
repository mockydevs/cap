{
  "manifest_version": 3,
  "name": "Cap Meeting Recorder",
  "version": "0.2.0",
  "description": "Record a meeting tab (audio or video) with a visible indicator and send the transcript to the Calari portal.",
  "key": "",
  "minimum_chrome_version": "116",
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Cap",
    "default_icon": {
      "16": "src/icon16.png",
      "32": "src/icon32.png",
      "48": "src/icon48.png",
      "128": "src/icon.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "src/options.html",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "identity"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://meetings.calari.tech/*"
  ],
  "commands": {
    "toggle-recording": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Start or stop recording the current tab"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["src/meet.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [],
  "icons": {
    "16": "src/icon16.png",
    "32": "src/icon32.png",
    "48": "src/icon48.png",
    "128": "src/icon.png"
  }
}
