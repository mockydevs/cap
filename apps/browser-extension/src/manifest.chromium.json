{
  "manifest_version": 3,
  "name": "Cap Screen Recorder",
  "version": "0.2.0",
  "description": "Record your tab, screen, window, or camera and upload straight to Cap from Chrome or Edge.",
  "permissions": [
    "storage",
    "tabs",
    "contextMenus",
    "offscreen",
    "tabCapture",
    "desktopCapture",
    "identity",
    "notifications"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "minimum_chrome_version": "109",
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Cap",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "commands": {
    "start-recording": {
      "suggested_key": { "default": "Ctrl+Shift+9", "mac": "Command+Shift+9" },
      "description": "Open the Cap recorder"
    }
  }
}
