{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cap",
  "version": "0.1.0",
  "identifier": "dev.mocky.cap",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cap",
        "width": 1180,
        "height": 820,
        "minWidth": 760,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": { "wix": { "language": "en-US" } },
    "macOS": {
      "minimumSystemVersion": "12.3",
      "entitlements": "Entitlements.plist"
    },
    "linux": { "appimage": { "bundleMediaFramework": true } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDOTNDMDVBOTFFMTYxOTQKUldTVVllR1JXc0NUck05ZU0xL3dTTlNESENkRWcvK2x5Y0Ftejd4TXFRdERMZnpMeVNGWlRyVUYK",
      "endpoints": [
        "https://github.com/mockydevs/cap/releases/latest/download/latest.json"
      ]
    }
  }
}
